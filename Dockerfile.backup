# 앱과 같은 PostgreSQL 16 클라이언트. 태그와 이미지 digest를 함께 고정한다.
FROM postgres:16.14-alpine@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777
RUN apk add --no-cache age=1.3.2-r1
COPY scripts/backup.sh /ops/backup.sh
RUN sed -i 's/\r$//' /ops/backup.sh && chmod 555 /ops/backup.sh
ENTRYPOINT ["/ops/backup.sh"]
